flowchart TB
    classDef layer fill:#f7f3d6,stroke:#b7aa4b,stroke-width:2px,color:#1f2937;
    classDef module fill:#eef2ff,stroke:#8b9cf6,stroke-width:1.5px,color:#111827;
    classDef note fill:#ecfeff,stroke:#38bdf8,stroke-width:1.5px,color:#0f172a;
    classDef external fill:#fef2f2,stroke:#f97373,stroke-width:1.5px,color:#111827;

    subgraph L0["启动入口层 main/"]
        Main["app_main()<br/>芯片信息、启动日志、系统初始化编排"]
    end

    subgraph L1["业务任务层 task/"]
        TaskList["TASK_StartAll()<br/>创建各业务任务"]
        State["task_state<br/>统一运行态状态中心"]
        Tasks["camera / buzzer / servo / uart / dht11 / rc522 / mq2 / sw180 / oled<br/>采样、控制、报警、显示、命令处理"]
    end

    subgraph L2["联网与云端通信层 MQTT/"]
        Mqtt["savebox_mqtt<br/>Wi-Fi、MQTT 建连、状态上报、云端命令"]
        Http["savebox_http_upload<br/>图片上传、状态快照上传"]
        Cfg["savebox_mqtt_config.h<br/>SSID、Broker、Topic、HTTP URL"]
    end

    subgraph L3["设备功能封装层 ESP_APP/"]
        AppInit["APP_Init()<br/>初始化业务外设模块"]
        Apps["app_camera / app_DHT11 / app_mq2 / app_rc522 / app_servo / app_sw180 / app_Buzzer<br/>把具体设备能力封装成应用接口"]
    end

    subgraph L4["板级支持与兼容层 ESP_BSP/ + compat/"]
        BspInit["BSP_Init()<br/>初始化板级资源"]
        Bsp["bsp_platform / bsp_gpio / bsp_adc / bsp_timer / bsp_uart / app_oled<br/>GPIO、ADC、SPI、UART、PWM、OLED 适配"]
        Board["savebox_board.h<br/>引脚映射、任务开关、模块参数"]
        Compat["compat/*.h<br/>STM32 HAL 风格兼容头"]
    end

    subgraph L5["系统组件层 ESP-IDF + 第三方组件"]
        Idf["FreeRTOS / ESP-IDF Drivers / Wi-Fi / MQTT / HTTP / NVS / Event"]
        Third["cJSON / esp32-camera / mbedTLS"]
    end

    subgraph L6["硬件与外部系统"]
        Hw["ESP32-S3 + 外设<br/>Camera、OLED、DHT11、MQ-2、SW180、RC522、Servo、Buzzer、UART"]
        Cloud["云端/服务器<br/>Huawei IoTDA MQTT Broker + HTTP 图片服务"]
    end

    Main --> BspInit
    Main --> AppInit
    Main --> State
    Main --> TaskList
    Main --> Mqtt

    TaskList --> Tasks
    Tasks <--> State
    Mqtt <--> State
    Http --> State

    Tasks --> Apps
    Tasks --> Http
    Mqtt --> Tasks
    Mqtt --> Cfg
    Http --> Cfg

    AppInit --> Apps
    Apps --> Bsp
    Apps --> Third

    BspInit --> Bsp
    Bsp --> Board
    Bsp --> Compat
    Bsp --> Idf

    Idf --> Hw
    Third --> Hw
    Mqtt --> Cloud
    Http --> Cloud

    class Main,TaskList,State,Tasks,Mqtt,Http,Cfg,AppInit,Apps,BspInit,Bsp,Board,Compat,Idf,Third,Hw,Cloud module;
